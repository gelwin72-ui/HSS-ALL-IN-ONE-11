rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Allow Read/Write for seamless school management & multi-device sync
    match /{document=**} {
      allow read, write: if true;
    }

    // School-Specific Multi-Tenant Data (Isolated by schoolCode)
    match /schools/{schoolCode} {
      allow read, write: if true;

      match /teachers/{teacherId} {
        allow read, write: if true;
      }

      match /teacherSignups/{teacherId} {
        allow read, write: if true;
      }

      match /activities/{activityId} {
        allow read, write: if true;
      }

      match /classes/{classId} {
        allow read, write: if true;

        match /students/{studentId} {
          allow read, write: if true;
        }

        match /attendance/{attendanceId} {
          allow read, write: if true;
        }

        match /exams/{examId} {
          allow read, write: if true;
        }
      }

      match /students/{studentId} {
        allow read, write: if true;
      }

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    match /users/{userId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    match /email_accounts/{emailKey} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    match /teachers/{teacherId} {
      allow read, write: if true;
    }

    match /teacherSignups/{teacherId} {
      allow read, write: if true;
    }

    match /gmail/{emailKey} {
      allow read, write: if true;
    }

    match /schoolAdmins/{adminId} {
      allow read, write: if true;
    }

    match /broadcasts/{broadcastId} {
      allow read, write: if true;
    }

    match /cloud_files/{fileId} {
      allow read, write: if true;
    }

    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
