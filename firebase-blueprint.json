        "adminAccount": { "type": "object" },
        "appData": { "type": "object" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["email", "role", "schoolCode"]
    },
    "admins": {
