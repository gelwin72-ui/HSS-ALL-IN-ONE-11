      "title": "User Account & Role Profile",
      "description": "Authenticated user profile with RBAC, schoolCode tenancy, and active state keyed by Firebase Auth UID (no plaintext passwords stored)",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "maxLength": 200 },
        "gmail": { "type": "string", "maxLength": 200 },
        "role": { "type": "string", "enum": ["teacher", "admin", "schoolAdmin"] },
        "schoolCode": { "type": "string", "maxLength": 64 },
        "schoolName": { "type": "string", "maxLength": 200 },
        "active": { "type": "boolean" },
        "status": { "type": "string", "maxLength": 40 },
        "displayName": { "type": "string", "maxLength": 150 },
        "name": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 40 },
        "dob": { "type": "string", "maxLength": 32 },
        "photoURL": { "type": "string", "maxLength": 1000 },
        "deviceId": { "type": "string", "maxLength": 128 },
        "lastSyncedAt": { "type": "string", "maxLength": 64 },
